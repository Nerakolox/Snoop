{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Snoop",
  "version": "0.1.0",
  "identifier": "org.feedra.snoop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Snoop",
        "width": 1180,
        "height": 760,
        "minWidth": 960,
        "minHeight": 620,
        "visible": false,
        "resizable": true,
        "decorations": true,
        "transparent": true,
        "skipTaskbar": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Productivity",
    "copyright": "Copyright © 2026 Feedra",
    "shortDescription": "Snoop — 应用与键鼠活动记录",
    "longDescription": "Snoop 在本机记录应用切换与键鼠活动，数据仅保存在本地。",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon-macos.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
